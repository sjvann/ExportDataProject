@page
@model TableDetailModel
@{
    ViewData["Title"] = Model.TableName;
    var panel = Model.ActivePanel is "sample" or "relations" ? Model.ActivePanel : "schema";
    var columns = Model.TableSchema?.Columns;
    var sampleRows = Model.SampleData?.ToList();
    var relations = Model.Relations?.ToList();
}

<div class="workspace workspace-detail">
    <header class="detail-bar">
        <a class="back-link" href="/">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            工作台
        </a>
        <div class="detail-title">
            <h1 class="mono">@(string.IsNullOrEmpty(Model.TableName) ? "資料表" : Model.TableName)</h1>
            @if (Model.TableSchema != null)
            {
                <p>@Model.TableSchema.Columns.Count 個欄位 · @Model.TableSchema.RowCount.ToString("N0") 筆</p>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="banner alert @(Model.IsSuccess ? "alert-success" : "alert-danger")" role="@(Model.IsSuccess ? "status" : "alert")">
            <p class="mb-0">@Model.Message</p>
        </div>
    }

    @if (!Model.HasConnection || string.IsNullOrWhiteSpace(Model.TableName))
    {
        var missingTable = string.IsNullOrWhiteSpace(Model.TableName);
        <div class="empty-panel">
            <h2>@(missingTable ? "沒有資料表" : "尚未連線")</h2>
            <p>@(missingTable ? "請從工作台的清單開啟一張資料表。" : "請先回工作台連上資料庫。連線會保留到你按「取消連線」。")</p>
            <a class="btn btn-primary" href="/">回工作台</a>
        </div>
    }
    else
    {
    <form method="post" class="detail-form">
        <input type="hidden" asp-for="TableName" />

        <div class="tabs" data-tabs>
            <div class="tablist" role="tablist" aria-label="資料表內容">
                <button type="button" class="tab" role="tab" id="tab-schema" aria-controls="panel-schema" aria-selected="@(panel == "schema" ? "true" : "false")" tabindex="@(panel == "schema" ? "0" : "-1")">結構</button>
                <button type="button" class="tab" role="tab" id="tab-sample" aria-controls="panel-sample" aria-selected="@(panel == "sample" ? "true" : "false")" tabindex="@(panel == "sample" ? "0" : "-1")">範例</button>
                <button type="button" class="tab" role="tab" id="tab-relations" aria-controls="panel-relations" aria-selected="@(panel == "relations" ? "true" : "false")" tabindex="@(panel == "relations" ? "0" : "-1")">關聯</button>
            </div>

            <div class="tab-panel" role="tabpanel" id="panel-schema" aria-labelledby="tab-schema" @(panel == "schema" ? null : "hidden")>
                @if (columns != null && columns.Count > 0)
                {
                    <div class="panel-toolbar">
                        <p>點欄位名稱看型別、鍵別與預設值。</p>
                        <button type="submit" name="action" value="schema" class="btn btn-sm btn-ghost">重新載入</button>
                    </div>
                    <div class="schema-split" data-picker>
                        <div class="schema-list" role="group" aria-label="欄位">
                            @for (var i = 0; i < columns.Count; i++)
                            {
                                var column = columns[i];
                                <button type="button" class="pick" data-pick id="col-tab-@i" aria-controls="col-@i" aria-pressed="@(i == 0 ? "true" : "false")">
                                    <span class="pick-line">
                                        <span class="mono">@column.ColumnName</span>
                                        @if (column.IsPrimaryKey)
                                        {
                                            <span class="key-badge key-pk">主鍵</span>
                                        }
                                        @if (column.IsForeignKey)
                                        {
                                            <span class="key-badge key-fk">外鍵</span>
                                        }
                                    </span>
                                    <span class="text-secondary small">@column.DataType</span>
                                </button>
                            }
                        </div>
                        <div class="schema-detail">
                            @for (var i = 0; i < columns.Count; i++)
                            {
                                var column = columns[i];
                                <article id="col-@i" @(i == 0 ? null : "hidden")>
                                    <h2 class="h6 mono">@column.ColumnName</h2>
                                    <dl class="def-list">
                                        <dt>型別</dt>
                                        <dd>@column.DataType</dd>
                                        <dt>空值</dt>
                                        <dd>@(column.IsNullable ? "可空" : "必填")</dd>
                                        <dt>主鍵</dt>
                                        <dd>@(column.IsPrimaryKey ? "是" : "否")</dd>
                                        <dt>外鍵</dt>
                                        <dd>
                                            @if (column.IsForeignKey && !string.IsNullOrEmpty(column.ReferencedTable))
                                            {
                                                <span class="mono">@column.ReferencedTable.@column.ReferencedColumn</span>
                                            }
                                            else if (column.IsForeignKey)
                                            {
                                                <span>是</span>
                                            }
                                            else
                                            {
                                                <span>否</span>
                                            }
                                        </dd>
                                        <dt>預設值</dt>
                                        <dd>@(string.IsNullOrEmpty(column.DefaultValue) ? "無" : column.DefaultValue)</dd>
                                        <dt>長度</dt>
                                        <dd>
                                            @if (column.MaxLength.HasValue)
                                            {
                                                @column.MaxLength.Value.ToString()
                                            }
                                            else if (column.Precision.HasValue)
                                            {
                                                @($"{column.Precision},{column.Scale}")
                                            }
                                            else
                                            {
                                                <span>無</span>
                                            }
                                        </dd>
                                    </dl>
                                </article>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-panel">
                        <h2>結構還沒載入</h2>
                        <p>開啟資料表時會直接讀取欄位。這次沒有讀到，可以再試一次。</p>
                        <button type="submit" name="action" value="schema" class="btn btn-primary">重新載入結構</button>
                    </div>
                }
            </div>

            <div class="tab-panel" role="tabpanel" id="panel-sample" aria-labelledby="tab-sample" @(panel == "sample" ? null : "hidden")>
                @if (sampleRows != null && sampleRows.Count > 0)
                {
                    <div class="panel-toolbar">
                        <p>前 @sampleRows.Count 筆。寬表在這個窗格裡左右捲動。</p>
                        <button type="submit" name="action" value="sample" class="btn btn-sm btn-ghost">重新載入</button>
                    </div>
                    <div class="pane-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    @foreach (var key in sampleRows[0].Keys)
                                    {
                                        <th scope="col" class="mono">@key</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in sampleRows)
                                {
                                    <tr>
                                        @foreach (var value in row.Values)
                                        {
                                            <td class="mono">
                                                @if (value == null)
                                                {
                                                    <span class="text-secondary">空值</span>
                                                }
                                                else
                                                {
                                                    @value.ToString()
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-panel">
                        <h2>範例資料</h2>
                        <p>只取少數列，用來對照欄位的值長什麼樣子。</p>
                        <button type="submit" name="action" value="sample" class="btn btn-primary">載入範例</button>
                    </div>
                }
            </div>

            <div class="tab-panel" role="tabpanel" id="panel-relations" aria-labelledby="tab-relations" @(panel == "relations" ? null : "hidden")>
                @if (relations != null && relations.Count > 0)
                {
                    <div class="panel-toolbar">
                        <p>@relations.Count 條關聯。點一列看父欄、子欄與約束名稱。</p>
                        <button type="submit" name="action" value="relations" class="btn btn-sm btn-ghost">重新載入</button>
                    </div>
                    <div class="schema-split" data-picker>
                        <div class="schema-list" role="group" aria-label="關聯">
                            @for (var i = 0; i < relations.Count; i++)
                            {
                                var relation = relations[i];
                                <button type="button" class="pick" data-pick id="rel-tab-@i" aria-controls="rel-@i" aria-pressed="@(i == 0 ? "true" : "false")">
                                    <span class="pick-line">
                                        <span class="mono">@relation.ParentTable</span>
                                        <svg class="relation-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span class="mono">@relation.ChildTable</span>
                                    </span>
                                </button>
                            }
                        </div>
                        <div class="schema-detail">
                            @for (var i = 0; i < relations.Count; i++)
                            {
                                var relation = relations[i];
                                <article id="rel-@i" @(i == 0 ? null : "hidden")>
                                    <h2 class="h6">關聯</h2>
                                    <dl class="def-list">
                                        <dt>父資料表</dt>
                                        <dd class="mono">@relation.ParentTable</dd>
                                        <dt>父欄位</dt>
                                        <dd class="mono">@relation.ParentColumn</dd>
                                        <dt>子資料表</dt>
                                        <dd class="mono">@relation.ChildTable</dd>
                                        <dt>子欄位</dt>
                                        <dd class="mono">@relation.ChildColumn</dd>
                                        <dt>約束名稱</dt>
                                        <dd class="mono">@relation.ConstraintName</dd>
                                    </dl>
                                </article>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-panel">
                        <h2>關聯</h2>
                        <p>這裡只列這張表的父表與子表，不用把整庫的關聯表捲出來。</p>
                        <button type="submit" name="action" value="relations" class="btn btn-primary">載入關聯</button>
                    </div>
                }
            </div>
        </div>
    </form>
    }
</div>
