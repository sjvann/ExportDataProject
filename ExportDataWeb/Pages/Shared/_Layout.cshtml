<!DOCTYPE html>
<html lang="zh-Hant" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1E3A5F" />
    <title>@ViewData["Title"] - 析庫</title>
    <script>document.documentElement.classList.remove("no-js");</script>
    <link rel="icon" href="~/brand/app-icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExportDataWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="app-header">
        <a class="brand" asp-area="" asp-page="/Index">
            <img class="brand-mark" src="~/brand/app-icon.svg" width="28" height="28" alt="" />
            <span class="brand-text">
                <span class="brand-name">析庫</span>
                <span class="brand-tag">舊系統資料庫解析</span>
            </span>
        </a>
        <nav class="app-nav" aria-label="主要">
            <a class="app-nav-link nav-home" asp-area="" asp-page="/Index">工作台</a>
            <a class="app-nav-link" asp-area="" asp-page="/Privacy">隱私</a>
        </nav>
    </header>
    <div id="app-update" class="app-update" hidden>
        <p id="app-update-message" class="app-update-message" role="status"></p>
        <p id="app-update-detail" class="app-update-detail" hidden></p>
        <progress id="app-update-meter" hidden max="100" aria-label="下載進度"></progress>
        <button type="button" class="btn btn-primary btn-sm" id="app-update-action" hidden>下載並更新</button>
    </div>
    <main id="main" class="app-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/update.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/workspace.js" asp-append-version="true"></script>
</body>
</html>
